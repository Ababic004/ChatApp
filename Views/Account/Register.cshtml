@model RegisterViewModel
@{ ViewData["Title"] = "Registracija"; Layout = null; }

<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Registracija – ChatApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
    <style>
        body { background: #f0f2f5; display:flex; align-items:center; justify-content:center; min-height:100vh; }
        .auth-card { width: 100%; max-width: 420px; }
    </style>
</head>
<body>
<div class="auth-card">
    <div class="text-center mb-4">
        <div class="display-6 fw-bold text-primary"><i class="bi bi-chat-dots-fill"></i> ChatApp</div>
        <p class="text-muted">Kreirajte novi nalog</p>
    </div>
    <div class="card shadow-sm border-0 rounded-4 p-4">
        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger small py-2">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }
            <div class="mb-3">
                <label class="form-label small fw-semibold">Korisničko ime</label>
                <input asp-for="UserName" class="form-control" placeholder="korisnik123" autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Ime za prikaz <span class="text-muted fw-normal">(opciono)</span></label>
                <input asp-for="DisplayName" class="form-control" placeholder="Marko Marković" />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Lozinka</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="min. 4 karaktera" />
            </div>
            <div class="mb-4">
                <label class="form-label small fw-semibold">Potvrdi lozinku</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Registruj se</button>
        </form>
        <hr class="my-3"/>
        <div class="text-center small">
            Već imate nalog? <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold">Prijavite se</a>
        </div>
    </div>
</div>
</body>
</html>
